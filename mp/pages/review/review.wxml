<view class="card">
  <view class="card-head"><view class="card-title">待我审批（{{list.length}}）</view></view>
  <view wx:if="{{!list.length}}" class="empty">暂无待处理申请</view>
  <view class="row" wx:for="{{list}}" wx:key="id">
    <view class="row-main">
      <view>
        <view class="row-title">{{item.name}} · {{item.typeName}}</view>
        <view class="row-sub">{{item.dept}} · {{item.title}}</view>
        <view class="row-sub">{{item.flow}}</view>
        <view class="row-sub">{{item.track}}</view>
      </view>
      <view class="badge {{item.tone}}">{{item.status}}</view>
    </view>
    <view class="row-actions" style="margin-top:16rpx">
      <text class="link-btn" data-id="{{item.id}}" bindtap="onView">查看</text>
      <text wx:if="{{item.can}}" class="link-btn" data-id="{{item.id}}" bindtap="onPass">通过</text>
      <text wx:if="{{item.can}}" class="link-btn del" data-id="{{item.id}}" bindtap="onReject">驳回</text>
    </view>
  </view>
</view>

<!-- 手写签字审批弹窗 -->
<view class="mask" wx:if="{{signVisible}}">
  <view class="sign-card">
    <view class="card-title">审批签字</view>
    <canvas canvas-id="signCanvas" class="sign-canvas"
      bindtouchstart="sStart" bindtouchmove="sMove" bindtouchend="sEnd"></canvas>
    <view class="field">
      <label>联系电话</label>
      <input value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <label>审批意见</label>
      <textarea value="{{opinion}}" bindinput="onOpinion" placeholder="同意 / 意见说明" />
    </view>
    <view class="row-actions">
      <text class="link-btn ghost" bindtap="clearSign">清除签名</text>
      <text class="link-btn ghost" bindtap="cancelSign">取消</text>
      <text class="link-btn" bindtap="confirmSign">确认通过</text>
    </view>
  </view>
</view>
