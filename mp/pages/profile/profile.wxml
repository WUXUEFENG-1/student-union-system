<view class="card">
  <view class="row-main">
    <view>
      <view class="card-title">{{cur.name}}</view>
      <view class="sub">{{roleName}} · {{cur.dept}} · {{cur.title}}</view>
    </view>
  </view>
  <view class="timeline" style="margin-top:20rpx">
    <view class="ti"><view class="dot"></view><view>学号：{{cur.sno || '—'}}</view></view>
    <view class="ti"><view class="dot"></view><view>班级：{{cur.class || '—'}}</view></view>
    <view class="ti"><view class="dot"></view><view>专业：{{cur.major || '—'}}</view></view>
    <view class="ti"><view class="dot"></view><view>电话：{{cur.phone || '—'}}</view></view>
  </view>
</view>

<view class="card">
  <view class="row" data-path="/pages/applies/applies" bindtap="go"><view class="row-title">我的申请</view></view>
  <view class="row" data-path="/pages/review/review" bindtap="go"><view class="row-title">待我审批</view></view>
  <view class="row" data-path="/pages/notice/notice" bindtap="go"><view class="row-title">通知公告</view></view>
</view>

<view class="card">
  <button class="btn danger" bindtap="logout">退出登录</button>
</view>
