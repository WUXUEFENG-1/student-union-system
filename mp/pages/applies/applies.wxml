<view class="card">
  <view class="card-head"><view class="card-title">{{title}}（{{list.length}}）</view><text class="link-btn" bindtap="onExport">导出CSV</text></view>
  <view wx:if="{{!list.length}}" class="empty">暂无申请记录</view>
  <view class="row" wx:for="{{list}}" wx:key="id">
    <view class="row-main">
      <view>
        <view class="row-title">{{item.name}} · {{item.typeName}}</view>
        <view class="row-sub">{{item.dept}} · {{item.title}}</view>
        <view class="row-sub">{{item.flow}}</view>
        <view class="row-sub">{{item.track}}</view>
      </view>
      <view class="badge {{item.tone}}">{{item.status}}</view>
    </view>
    <view class="row-actions" style="margin-top:16rpx">
      <text class="link-btn" data-type="apply" data-id="{{item.id}}" bindtap="onView">查看</text>
    </view>
  </view>
</view>
